{
  "schemaVersion": 1,
  "projectName": "Handwell project Shell v1 Adapter proposal test fixture compatibility",
  "authorizationSource": ".ans/decisions/handwell-pm-approved-project-shell-v1-config-authorization.md",
  "sourceAuthorization": [
    ".ans/decisions/handwell-pm-approved-project-shell-v1-authorization.md",
    ".ans/decisions/handwell-pm-approved-project-shell-v1-config-authorization.md"
  ],
  "designFiles": [
    ".ans/decisions/handwell-pm-approved-project-shell-v1-design.md"
  ],
  "maxConcurrentWorkers": 1,
  "allowRequirementRevision": false,
  "allowDesignRevision": false,
  "roles": {
    "AgentAdapterEngineer": {
      "card": ".ans/roles/AgentAdapterEngineer/role-card.md",
      "boundary": ".ans/roles/AgentAdapterEngineer/boundary.md",
      "writeFiles": [
        "tests/adapters/test_proposal.mjs"
      ],
      "operations": [
        "repair",
        "test"
      ],
      "autoDispatch": true,
      "checks": {
        "proposal": {
          "argv": [
            "node",
            "--test",
            "tests/adapters/test_proposal.mjs"
          ],
          "timeoutSeconds": 300
        },
        "adapter_regression": {
          "argv": [
            "node",
            "--test",
            "tests/adapters/test_proposal.mjs",
            "tests/adapters/test_pi_provider.mjs",
            "tests/adapters/test_pi_service.mjs",
            "tests/adapters/test_control_tools.mjs"
          ],
          "timeoutSeconds": 300
        }
      }
    }
  }
}
