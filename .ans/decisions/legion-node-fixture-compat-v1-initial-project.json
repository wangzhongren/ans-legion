{
  "schemaVersion": 1,
  "projectName": "Legion Runtime",
  "authorizationSource": "Direct customer GUI v1 开发; necessary strict Node test compatibility reviewed by original PM; .ans/decisions/legion-node-fixture-compat-v1-proposal.md",
