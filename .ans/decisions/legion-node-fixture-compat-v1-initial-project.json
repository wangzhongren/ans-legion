        "docs/roles/Supervisor/api-spec.md",
        "docs/roles/Supervisor/changelog.md",
        "docs/roles/Supervisor/docs/design/2026-10-07_design_desktop-gui-v1.md",
        "docs/roles/Supervisor/docs/architecture.md",
        "docs/roles/Supervisor/docs/delivery-desktop-gui-v1.md"
