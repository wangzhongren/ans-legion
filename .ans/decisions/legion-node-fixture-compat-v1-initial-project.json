      "autoDispatch": true,
      "card": ".ans/roles/ProjectManager/node-compat-role-card.md",
      "boundary": ".ans/roles/ProjectManager/node-compat-boundary.md",
      "operations": [
        "implement",
        "review",
        "test"
      ],
      "writeFiles": [
        "tests/package/test_package.mjs"
      ],
      "checks": {
        "package": {
          "argv": [
            "node",
            "--test",
            "tests/package/test_package.mjs"
          ],
          "timeoutSeconds": 300
        }
      }
    },
    "Supervisor": {
      "autoDispatch": true,
